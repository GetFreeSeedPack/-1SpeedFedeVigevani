        Marco.Size = UDim2.new(0, 240, 0, 200)
        BtnAutoFarm.Visible = true
        BtnTP.Visible = true
        BtnOcultar.Visible = true
        Estado.Visible = true
        BtnMinimizar.Text = "−"
    end
end)

