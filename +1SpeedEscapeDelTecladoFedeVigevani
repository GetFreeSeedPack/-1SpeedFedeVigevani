-- 🔄 FUNCIÓN PRINCIPAL
local function RevisarPosicion()
    while task.wait(TIEMPO_ESPERA) do
        if not AutoFarmActivo then continue end
        
        local Personaje = Jugador.Character
        if not Personaje then continue end
        local Root = Personaje:FindFirstChild("HumanoidRootPart")
        if not Root then continue end
        
        local Distancia = (Root.Position - DESTINO_AUTO).Magnitude
        
        if Distancia > DISTANCIA_MAXIMA then
            Root.CFrame = CFrame.new(DESTINO_AUTO)
            Estado.Text = "Regresando... ✅"
        else
            Estado.Text = "En zona ✅"
        end
    end
end

-- 🎮 BOTONES
BtnAutoFarm.MouseButton1Click:Connect(function()
    AutoFarmActivo = not AutoFarmActivo
    
    if AutoFarmActivo then
        BtnAutoFarm.Text = "⏹ DETENER"
        BtnAutoFarm.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        Estado.Text = "Estado: ✅ ACTIVO"
        Estado.TextColor3 = Color3.fromRGB(80, 255, 80)
        task.spawn(RevisarPosicion)
    else
        BtnAutoFarm.Text = "▶ AUTO FARM"
        BtnAutoFarm.BackgroundColor3 = Color3.fromRGB(60, 60, 180)
        Estado.Text = "Estado: ❌ APAGADO"
        Estado.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

-- TP a Treadmill X2
BtnTP.MouseButton1Click:Connect(function()
    local Personaje = Jugador.Character
    if not Personaje then return end
    local Root = Personaje:FindFirstChild("HumanoidRootPart")
    if not Root then return end
    
    Root.CFrame = CFrame.new(DESTINO_TREADMILL)
    Estado.Text = "Teletransportado ✅"
end)

-- MINIMIZAR / RESTAURAR
local Minimizado = false
BtnMinimizar.MouseButton1Click:Connect(function()
    Minimizado = not Minimizado
    if Minimizado then
        Marco.Size = UDim2.new(0, 240, 0, 45)
        BtnAutoFarm.Visible = false
        BtnTP.Visible = false
        BtnOcultar.Visible = false
        Estado.Visible = false
        BtnMinimizar.Text = "+"
    else
        Marco.Size = UDim2.new(0, 240, 0, 200)
        BtnAutoFarm.Visible = true
        BtnTP.Visible = true
        BtnOcultar.Visible = true
        Estado.Visible = true
        BtnMinimizar.Text = "−"
    end
end)

-- OCULTAR / MOSTRAR (estilo Chili Hub)
local Oculto = false
BtnOcultar.MouseButton1Click:Connect(function()
    Oculto = not Oculto
    if Oculto then
        Marco.Visible = false
        BtnMostrar.Visible = true
    else
        Marco.Visible = true
        BtnMostrar.Visible = false
    end
end)

-- Botón pequeño para MOSTRAR
BtnMostrar.MouseButton1Click:Connect(function()
    Oculto = false
    Marco.Visible = true
    BtnMostrar.Visible = false
end)
