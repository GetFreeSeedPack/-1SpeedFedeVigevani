-- 🔄 FUNCIÓN AUTO FARM
local function RevisarPosicion()
    while task.wait(TIEMPO_ESPERA) do
        if not AutoFarmActivo then continue end
        
        local Personaje = Jugador.Character
        if not Personaje then continue end
        local Root = Personaje:FindFirstChild("HumanoidRootPart")
        if not Root then continue end
        
        local Distancia = (Root.Position - DESTINO_AUTO).Magnitude
        
        if Distancia > DISTANCIA_MAXIMA then
            Root.CFrame = CFrame.new(DESTINO_AUTO)
            Estado.Text = "Regresando... ✅"
        else
            Estado.Text = "Ganando aquí ✅"
        end
    end
end

-- 🎮 BOTONES
BtnAutoFarm.MouseButton1Click:Connect(function()
    AutoFarmActivo = not AutoFarmActivo
    if AutoFarmActivo then
        BtnAutoFarm.Text = "⏹ DETENER"
        BtnAutoFarm.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        Estado.Text = "✅ ACTIVO"
        Estado.TextColor3 = Color3.fromRGB(80, 255, 80)
        task.spawn(RevisarPosicion)
    else
        BtnAutoFarm.Text = "▶ AUTO FARM"
        BtnAutoFarm.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        Estado.Text = "❌ APAGADO"
        Estado.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

BtnTP.MouseButton1Click:Connect(function()
    local Personaje = Jugador.Character
    if not Personaje then return end
    local Root = Personaje:FindFirstChild("HumanoidRootPart")
    if not Root then return end
    Root.CFrame = CFrame.new(DESTINO_TREADMILL)
    Estado.Text = "Teletransportado ✅"
end)

